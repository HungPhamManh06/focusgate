{
  "manifest_version": 3,
  "name": "FocusGate Web Blocker",
  "version": "1.0.0",
  "description": "Blocks distracting websites until your FocusGate daily Must-Do plan is complete.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://focusgate-blue.vercel.app/*",
    "https://dyfdeceiszmxozdqugon.supabase.co/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusGate Blocker"
  }
}
