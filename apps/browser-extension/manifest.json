{
  "manifest_version": 3,
  "name": "FocusGate Blocker",
  "version": "1.1.0",
  "description": "Blocks distracting websites & enables YouTube Study Mode until your FocusGate daily Must-Do plan is complete.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://focusgate-blue.vercel.app/*",
    "https://dyfdeceiszmxozdqugon.supabase.co/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "css": ["youtube-study.css"],
      "js": ["youtube-study.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusGate Blocker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
