<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal device administrator declaration. FocusGate relies on Device Owner
  package suspension and optionally lock-task mode; it does not request wipe or
  password-reset policies for Personal Strict Mode.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
