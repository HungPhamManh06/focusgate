<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/streak_widget_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gate Locked"
        android:textColor="#F87171"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/streak_widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="FocusGate"
        android:textColor="#FAF7F5"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/streak_widget_cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp"
        android:text="⚡ 25m Focus"
        android:textColor="#FFFFFF"
        android:textSize="11.5sp"
        android:textStyle="bold" />
</LinearLayout>
