# =============================================================================
# FocusGate – environment template
# Copy to .env (web) / .env.local and fill in. NEVER commit real values.
# =============================================================================

# --- Supabase (client-safe) ------------------------------------------------
# Project URL and the *anon* key only. Both are public by design; RLS enforces access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server / local tooling only) --------------------------------
# Used by the Supabase CLI and Edge Functions. Never expose to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Web app ---------------------------------------------------------------
# Public origin used for auth redirects and same-origin checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Windows agent (dev only) ----------------------------------------------
# The agent signs in with its own device token; the password is never stored.
# Production credentials are protected with Windows DPAPI, not in .env.
FOCUSGATE_API_URL=http://localhost:3000
